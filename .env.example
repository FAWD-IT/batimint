# =============================================================================
# Batimint — variables d'environnement (copier en .env pour le développement)
# Aucune valeur secrète réelle ici : uniquement des valeurs de développement.
# En production (Coolify), voir docs/10-deploiement-coolify.md.
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info

# --- Base de données ----------------------------------------------------------
# Rôle applicatif (sans BYPASSRLS). Créé/mis à jour automatiquement par `pnpm db:migrate`
# à partir de l'utilisateur et du mot de passe de cette URL.
DATABASE_URL=postgresql://batimint_app:batimint_app@localhost:5432/batimint
# Rôle propriétaire, utilisé uniquement pour les migrations et le seed.
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/batimint
# Base fantôme pour `prisma migrate dev` (dev uniquement).
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/batimint_shadow
# Base des tests d'intégration (propriétaire ; le rôle applicatif est dérivé de DATABASE_URL).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/batimint_test

# --- URLs ---------------------------------------------------------------------
# URL publique de l'interface (liens dans les e-mails, portails).
APP_URL=http://localhost:3000
# URL publique de l'API (webhooks, app mobile).
API_URL=http://localhost:4000
# URL de l'API vue depuis le serveur web (réseau interne en production).
API_INTERNAL_URL=http://localhost:4000
API_PORT=4000
WEB_PORT=3000
# Domaine des cookies (vide = domaine exact de l'interface).
COOKIE_DOMAIN=

# --- Secrets (générer des valeurs longues et aléatoires en production) ---------
# openssl rand -base64 48
SESSION_SECRET=dev-session-secret-change-me-0123456789abcdef
PORTAL_TOKEN_SECRET=dev-portal-secret-change-me-0123456789abcdef
# Clé de chiffrement applicatif des champs sensibles (INSS, secrets d'intégration) : 32 octets en base64.
FIELD_ENCRYPTION_KEY=ZGV2LWZpZWxkLWVuY3J5cHRpb24ta2V5LTMyYnl0ZXM=

# --- Stockage S3 (MinIO) --------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
# URL publique de S3 pour les URL pré-signées (navigateur). Vide = S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=
S3_REGION=eu-west-1
S3_ACCESS_KEY=batimint
S3_SECRET_KEY=batimint-dev-secret
S3_BUCKET_UPLOADS=batimint-uploads
S3_BUCKET_LEGAL=batimint-legal
S3_FORCE_PATH_STYLE=true

# --- E-mail (Mailpit en dev : http://localhost:8025) ---------------------------
MAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="Batimint <no-reply@batimint.local>"
# Domaine des adresses d'entrée par tenant (<slug>@in.<domaine>).
INBOUND_EMAIL_DOMAIN=in.batimint.local
INBOUND_EMAIL_PROVIDER=mock
INBOUND_EMAIL_WEBHOOK_SECRET=dev-inbound-secret

# --- Intégrations (mock par défaut : tout fonctionne sans clé) ------------------
PEPPOL_PROVIDER=mock
PEPPOL_GETPEPPR_API_KEY=
PEPPOL_GETPEPPR_WEBHOOK_SECRET=
PEPPOL_GETPEPPR_BASE_URL=https://api.getpeppr.dev

ACCOUNTING_PROVIDER=mock
CHIFT_CLIENT_ID=
CHIFT_CLIENT_SECRET=
CHIFT_ACCOUNT_ID=
CHIFT_BASE_URL=https://api.chift.eu

PAYMENTS_PROVIDER=mock
MOLLIE_API_KEY=
MOLLIE_WEBHOOK_SECRET=

ONSS_PROVIDER=mock
VAT_VALIDATOR_PROVIDER=mock

AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Observabilité ------------------------------------------------------------
SENTRY_DSN=

# --- Démo -------------------------------------------------------------------------
# true : le seed de démonstration est chargé au démarrage (instance de démo uniquement).
SEED_DEMO=false

# --- docker-compose.coolify.yml en local --------------------------------------------
# Sur Coolify, ces valeurs SERVICE_* sont générées automatiquement (ne pas les saisir).
SERVICE_URL_WEB=http://localhost:3000
SERVICE_URL_API=http://localhost:4000
SERVICE_USER_POSTGRES=batimint
SERVICE_PASSWORD_POSTGRES=local-postgres-password
SERVICE_PASSWORD_APPDB=local-app-db-password
SERVICE_PASSWORD_64_SESSION=local-session-secret-0123456789abcdef0123456789abcdef
SERVICE_PASSWORD_64_PORTAL=local-portal-secret-0123456789abcdef0123456789abcdef
SERVICE_PASSWORD_64_FIELDKEY=local-field-key-0123456789abcdef0123456789abcdef
SERVICE_USER_MINIO=batimint
SERVICE_PASSWORD_MINIO=local-minio-password
