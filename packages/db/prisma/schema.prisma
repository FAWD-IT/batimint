// Batimint — schéma de données.
// Conventions (docs/04) : id UUIDv7, tenant_id + RLS sur chaque table métier,
// montants en centimes (BigInt), quantités Decimal(14,4), taux Decimal(6,4).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Plateforme et organisation
// ---------------------------------------------------------------------------

enum Role {
  owner
  admin
  office
  site_manager
  worker
  accountant
}

enum Plan {
  essential
  pro
  expert
}

enum MembershipStatus {
  active
  disabled
}

model Tenant {
  id                     String    @id @default(uuid(7)) @db.Uuid
  name                   String
  legalName              String?   @map("legal_name")
  slug                   String    @unique
  legalForm              String?   @map("legal_form")
  enterpriseNumber       String?   @map("enterprise_number")
  vatNumber              String?   @map("vat_number")
  vatValidatedAt         DateTime? @map("vat_validated_at") @db.Timestamptz(3)
  street                 String?
  postalCode             String?   @map("postal_code")
  city                   String?
  country                String    @default("BE")
  email                  String?
  phone                  String?
  website                String?
  iban                   String?
  bic                    String?
  logoKey                String?   @map("logo_key")
  brandColor             String?   @map("brand_color")
  termsAndConditions     String?   @map("terms_and_conditions")
  legalMentions          String?   @map("legal_mentions")
  documentLocale         String    @default("fr") @map("document_locale")
  /// Paramètres métier (taux, coefficients, relances…) validés par zod (packages/contracts).
  settings               Json      @default("{}")
  plan                   Plan      @default(pro)
  trialEndsAt            DateTime? @map("trial_ends_at") @db.Timestamptz(3)
  featureFlags           Json      @default("{}") @map("feature_flags")
  /// Préfixe (0–999) des communications structurées.
  structuredCommPrefix   Int       @default(0) @map("structured_comm_prefix")
  onboardingCompletedAt  DateTime? @map("onboarding_completed_at") @db.Timestamptz(3)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships     Membership[]
  invitations     Invitation[]
  auditLogs       AuditLog[]
  outboxEvents    OutboxEvent[]
  notifications   Notification[]
  numberSequences NumberSequence[]

  @@map("tenants")
}

model User {
  id               String    @id @default(uuid(7)) @db.Uuid
  email            String    @unique
  name             String
  passwordHash     String?   @map("password_hash")
  emailVerifiedAt  DateTime? @map("email_verified_at") @db.Timestamptz(3)
  totpSecretEnc    String?   @map("totp_secret_enc")
  totpEnabledAt    DateTime? @map("totp_enabled_at") @db.Timestamptz(3)
  isPlatformAdmin  Boolean   @default(false) @map("is_platform_admin")
  locale           String    @default("fr")
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships   Membership[]
  sessions      Session[]
  notifications Notification[]

  @@map("users")
}

model Membership {
  id        String           @id @default(uuid(7)) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      Role
  status    MembershipStatus @default(active)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?          @map("created_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

model Session {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  activeTenantId String?   @map("active_tenant_id") @db.Uuid
  mfaPending     Boolean   @default(false) @map("mfa_pending")
  ip             String?
  userAgent      String?   @map("user_agent")
  impersonatorId String?   @map("impersonator_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum AuthTokenPurpose {
  magic_link
  password_reset
  email_verification
}

model AuthToken {
  id        String           @id @default(uuid(7)) @db.Uuid
  purpose   AuthTokenPurpose
  email     String
  userId    String?          @map("user_id") @db.Uuid
  tokenHash String           @unique @map("token_hash")
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([email, purpose])
  @@map("auth_tokens")
}

model Invitation {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  email      String
  name       String?
  role       Role
  tokenHash  String    @unique @map("token_hash")
  invitedBy  String?   @map("invited_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy  String?   @map("created_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, email])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Technique : audit, outbox, idempotence, notifications, numérotation
// ---------------------------------------------------------------------------

enum ActorType {
  user
  system
  portal
  platform_admin
  webhook
}

model AuditLog {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id")
  actorLabel String?   @map("actor_label")
  action     String
  entityType String    @map("entity_type")
  entityId   String?   @map("entity_id")
  changes    Json?
  ip         String?
  userAgent  String?   @map("user_agent")
  requestId  String?   @map("request_id")
  occurredAt DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, occurredAt])
  @@map("audit_logs")
}

model OutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  type          String
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  payload       Json
  actor         Json?
  version       Int       @default(1)
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([publishedAt, occurredAt])
  @@index([tenantId, aggregateType, aggregateId])
  @@map("outbox_events")
}

model ProcessedEvent {
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([consumer, eventId])
  @@map("processed_events")
}

model IdempotencyKey {
  tenantId       String   @map("tenant_id") @db.Uuid
  scope          String
  key            String
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([tenantId, scope, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String?
  link      String?
  data      Json?
  eventId   String?   @map("event_id") @db.Uuid
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([tenantId, userId, createdAt])
  @@map("notifications")
}

model NumberSequence {
  tenantId  String   @map("tenant_id") @db.Uuid
  docType   String   @map("doc_type")
  year      Int
  lastValue Int      @default(0) @map("last_value")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, docType, year])
  @@map("number_sequences")
}
