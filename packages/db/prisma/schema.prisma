// Batimint — schéma de données.
// Conventions (docs/04) : id UUIDv7, tenant_id + RLS sur chaque table métier,
// montants en centimes (BigInt), quantités Decimal(14,4), taux Decimal(6,4).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Plateforme et organisation
// ---------------------------------------------------------------------------

enum Role {
  owner
  admin
  office
  site_manager
  worker
  accountant
}

enum Plan {
  essential
  pro
  expert
}

enum MembershipStatus {
  active
  disabled
}

model Tenant {
  id                    String    @id @default(uuid(7)) @db.Uuid
  name                  String
  legalName             String?   @map("legal_name")
  slug                  String    @unique
  legalForm             String?   @map("legal_form")
  enterpriseNumber      String?   @map("enterprise_number")
  vatNumber             String?   @map("vat_number")
  vatValidatedAt        DateTime? @map("vat_validated_at") @db.Timestamptz(3)
  street                String?
  postalCode            String?   @map("postal_code")
  city                  String?
  country               String    @default("BE")
  email                 String?
  phone                 String?
  website               String?
  iban                  String?
  bic                   String?
  logoKey               String?   @map("logo_key")
  brandColor            String?   @map("brand_color")
  termsAndConditions    String?   @map("terms_and_conditions")
  legalMentions         String?   @map("legal_mentions")
  documentLocale        String    @default("fr") @map("document_locale")
  /// Paramètres métier (taux, coefficients, relances…) validés par zod (packages/contracts).
  settings              Json      @default("{}")
  plan                  Plan      @default(pro)
  trialEndsAt           DateTime? @map("trial_ends_at") @db.Timestamptz(3)
  featureFlags          Json      @default("{}") @map("feature_flags")
  /// Préfixe (0–999) des communications structurées.
  structuredCommPrefix  Int       @default(0) @map("structured_comm_prefix")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at") @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships        Membership[]
  invitations        Invitation[]
  auditLogs          AuditLog[]
  outboxEvents       OutboxEvent[]
  notifications      Notification[]
  numberSequences    NumberSequence[]
  teams              Team[]
  employees          Employee[]
  absences           Absence[]
  integrations       IntegrationConnection[]
  customers          Customer[]
  contacts           Contact[]
  sites              Site[]
  leads              Lead[]
  opportunities      Opportunity[]
  siteVisits         SiteVisit[]
  attachments        Attachment[]
  suppliers          Supplier[]
  items              Item[]
  assemblyComponents AssemblyComponent[]
  priceHistory       PriceHistory[]
  supplierPrices     SupplierPrice[]
  quotes             Quote[]
  quoteVersions      QuoteVersion[]
  quoteSections      QuoteSection[]
  quoteLines         QuoteLine[]
  signatures         Signature[]
  vatCertificates    VatCertificate[]
  portalTokens       PortalToken[]
  projects           Project[]
  budgetLines        BudgetLine[]
  tasks              Task[]
  invoices           Invoice[]
  invoiceLines       InvoiceLine[]
  timelineEntries    TimelineEntry[]
  changeOrders       ChangeOrder[]
  changeOrderLines   ChangeOrderLine[]
  projectCosts       ProjectCost[]
  comments           Comment[]

  @@map("tenants")
}

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  email           String    @unique
  name            String
  passwordHash    String?   @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  totpSecretEnc   String?   @map("totp_secret_enc")
  totpEnabledAt   DateTime? @map("totp_enabled_at") @db.Timestamptz(3)
  isPlatformAdmin Boolean   @default(false) @map("is_platform_admin")
  locale          String    @default("fr")
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships   Membership[]
  sessions      Session[]
  notifications Notification[]

  @@map("users")
}

model Membership {
  id        String           @id @default(uuid(7)) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      Role
  status    MembershipStatus @default(active)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?          @map("created_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

model Session {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  activeTenantId String?   @map("active_tenant_id") @db.Uuid
  mfaPending     Boolean   @default(false) @map("mfa_pending")
  ip             String?
  userAgent      String?   @map("user_agent")
  impersonatorId String?   @map("impersonator_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum AuthTokenPurpose {
  magic_link
  password_reset
  email_verification
}

model AuthToken {
  id        String           @id @default(uuid(7)) @db.Uuid
  purpose   AuthTokenPurpose
  email     String
  userId    String?          @map("user_id") @db.Uuid
  tokenHash String           @unique @map("token_hash")
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([email, purpose])
  @@map("auth_tokens")
}

model Invitation {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  email      String
  name       String?
  role       Role
  tokenHash  String    @unique @map("token_hash")
  invitedBy  String?   @map("invited_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy  String?   @map("created_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, email])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Technique : audit, outbox, idempotence, notifications, numérotation
// ---------------------------------------------------------------------------

enum ActorType {
  user
  system
  portal
  platform_admin
  webhook
}

model AuditLog {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id")
  actorLabel String?   @map("actor_label")
  action     String
  entityType String    @map("entity_type")
  entityId   String?   @map("entity_id")
  changes    Json?
  ip         String?
  userAgent  String?   @map("user_agent")
  requestId  String?   @map("request_id")
  occurredAt DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, occurredAt])
  @@map("audit_logs")
}

model OutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  type          String
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  payload       Json
  actor         Json?
  version       Int       @default(1)
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([publishedAt, occurredAt])
  @@index([tenantId, aggregateType, aggregateId])
  @@map("outbox_events")
}

model ProcessedEvent {
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([consumer, eventId])
  @@map("processed_events")
}

model IdempotencyKey {
  tenantId       String   @map("tenant_id") @db.Uuid
  scope          String
  key            String
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([tenantId, scope, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String?
  link      String?
  data      Json?
  eventId   String?   @map("event_id") @db.Uuid
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([tenantId, userId, createdAt])
  @@map("notifications")
}

model NumberSequence {
  tenantId  String   @map("tenant_id") @db.Uuid
  docType   String   @map("doc_type")
  year      Int
  lastValue Int      @default(0) @map("last_value")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, docType, year])
  @@map("number_sequences")
}

// ---------------------------------------------------------------------------
// Équipes, employés, absences (03 §1)
// ---------------------------------------------------------------------------

model Team {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  name             String
  color            String    @default("#2F4BFF")
  leaderEmployeeId String?   @map("leader_employee_id") @db.Uuid
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy        String?   @map("created_by") @db.Uuid

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members Employee[] @relation("TeamMembers")

  @@index([tenantId])
  @@map("teams")
}

model Employee {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  userId          String?   @map("user_id") @db.Uuid
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  email           String?
  phone           String?
  jobTitle        String?   @map("job_title")
  /// Clé du profil de taux horaire (paramètres du tenant).
  rateProfile     String?   @map("rate_profile")
  /// Coût horaire chargé, en centimes.
  hourlyCost      BigInt    @default(0) @map("hourly_cost")
  skills          String[]  @default([])
  /// INSS chiffré (AES-256-GCM, 05 §9) ; seuls Owner et Admin le déchiffrent.
  inssEnc         String?   @map("inss_enc")
  inssLast4       String?   @map("inss_last4")
  teamId          String?   @map("team_id") @db.Uuid
  isSubcontractor Boolean   @default(false) @map("is_subcontractor")
  active          Boolean   @default(true)
  hiredOn         DateTime? @map("hired_on") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy       String?   @map("created_by") @db.Uuid

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  team     Team?     @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  absences Absence[]

  @@unique([tenantId, userId])
  @@index([tenantId, active])
  @@map("employees")
}

enum AbsenceKind {
  leave
  sick
  training
  public_holiday
  other
}

model Absence {
  id         String      @id @default(uuid(7)) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  employeeId String      @map("employee_id") @db.Uuid
  kind       AbsenceKind
  startsOn   DateTime    @map("starts_on") @db.Date
  endsOn     DateTime    @map("ends_on") @db.Date
  /// Demi-journée : « am », « pm » ou null (journée entière).
  halfDay    String?     @map("half_day")
  note       String?
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy  String?     @map("created_by") @db.Uuid

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId, startsOn])
  @@map("absences")
}

// ---------------------------------------------------------------------------
// Intégrations (07) : état de connexion par tenant et par type
// ---------------------------------------------------------------------------

enum IntegrationKind {
  peppol
  accounting
  payments
  attendance
  ai
  inbound_email
}

enum IntegrationStatus {
  not_connected
  pending
  active
  error
}

model IntegrationConnection {
  id            String            @id @default(uuid(7)) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  kind          IntegrationKind
  provider      String
  status        IntegrationStatus @default(not_connected)
  externalId    String?           @map("external_id")
  config        Json              @default("{}")
  secretsEnc    String?           @map("secrets_enc")
  lastCheckedAt DateTime?         @map("last_checked_at") @db.Timestamptz(3)
  lastError     String?           @map("last_error")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind])
  @@map("integration_connections")
}

// ---------------------------------------------------------------------------
// CRM (03 §2)
// ---------------------------------------------------------------------------

enum CustomerKind {
  individual
  company
}

enum CustomerStatus {
  prospect
  customer
}

model Customer {
  id               String         @id @default(uuid(7)) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  kind             CustomerKind
  status           CustomerStatus @default(prospect)
  displayName      String         @map("display_name")
  firstName        String?        @map("first_name")
  lastName         String?        @map("last_name")
  companyName      String?        @map("company_name")
  legalForm        String?        @map("legal_form")
  enterpriseNumber String?        @map("enterprise_number")
  vatNumber        String?        @map("vat_number")
  /// Assujetti belge déposant des déclarations périodiques (autoliquidation, 05 §3).
  vatLiable        Boolean        @default(false) @map("vat_liable")
  peppolId         String?        @map("peppol_id")
  peppolReachable  Boolean?       @map("peppol_reachable")
  peppolCheckedAt  DateTime?      @map("peppol_checked_at") @db.Timestamptz(3)
  email            String?
  phone            String?
  street           String?
  postalCode       String?        @map("postal_code")
  city             String?
  country          String         @default("BE")
  notes            String?
  tags             String[]       @default([])
  source           String?
  paymentTermsDays Int?           @map("payment_terms_days")
  mergedIntoId     String?        @map("merged_into_id") @db.Uuid
  archivedAt       DateTime?      @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy        String?        @map("created_by") @db.Uuid

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts      Contact[]
  sites         Site[]
  opportunities Opportunity[]
  leads         Lead[]
  quotes        Quote[]

  @@index([tenantId, status])
  @@index([tenantId, email])
  @@index([tenantId, vatNumber])
  @@map("customers")
}

model Contact {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  firstName  String?  @map("first_name")
  lastName   String   @map("last_name")
  jobTitle   String?  @map("job_title")
  email      String?
  phone      String?
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy  String?  @map("created_by") @db.Uuid

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
  @@map("contacts")
}

/// Adresse de chantier (porte les critères du taux réduit de 6 %, 05 §3).
model Site {
  id                 String    @id @default(uuid(7)) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  customerId         String    @map("customer_id") @db.Uuid
  label              String?
  street             String
  postalCode         String    @map("postal_code")
  city               String
  country            String    @default("BE")
  latitude           Decimal?  @db.Decimal(9, 6)
  longitude          Decimal?  @db.Decimal(9, 6)
  isPrivateDwelling  Boolean   @default(true) @map("is_private_dwelling")
  firstOccupancyYear Int?      @map("first_occupancy_year")
  accessNotes        String?   @map("access_notes")
  archivedAt         DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy          String?   @map("created_by") @db.Uuid

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]
  quotes        Quote[]

  @@index([tenantId, customerId])
  @@map("sites")
}

enum LeadSource {
  web_form
  email
  manual
  phone
}

enum LeadStatus {
  new
  converted
  discarded
}

model Lead {
  id            String     @id @default(uuid(7)) @db.Uuid
  tenantId      String     @map("tenant_id") @db.Uuid
  source        LeadSource
  status        LeadStatus @default(new)
  name          String
  email         String?
  phone         String?
  companyName   String?    @map("company_name")
  street        String?
  postalCode    String?    @map("postal_code")
  city          String?
  message       String?
  payload       Json?
  customerId    String?    @map("customer_id") @db.Uuid
  opportunityId String?    @map("opportunity_id") @db.Uuid
  receivedAt    DateTime   @default(now()) @map("received_at") @db.Timestamptz(3)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy     String?    @map("created_by") @db.Uuid

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, receivedAt])
  @@map("leads")
}

enum OpportunityStage {
  new
  visit_planned
  quoting
  sent
  won
  lost
}

model Opportunity {
  id              String           @id @default(uuid(7)) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  customerId      String           @map("customer_id") @db.Uuid
  siteId          String?          @map("site_id") @db.Uuid
  title           String
  description     String?
  stage           OpportunityStage @default(new)
  position        Int              @default(0)
  estimatedAmount BigInt?          @map("estimated_amount")
  trade           String?
  ownerUserId     String?          @map("owner_user_id") @db.Uuid
  lostReason      String?          @map("lost_reason")
  wonAt           DateTime?        @map("won_at") @db.Timestamptz(3)
  lostAt          DateTime?        @map("lost_at") @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy       String?          @map("created_by") @db.Uuid

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  site     Site?       @relation(fields: [siteId], references: [id], onDelete: SetNull)
  visits   SiteVisit[]
  quotes   Quote[]

  @@index([tenantId, stage, position])
  @@index([tenantId, customerId])
  @@map("opportunities")
}

model SiteVisit {
  id                String    @id @default(uuid(7)) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  opportunityId     String    @map("opportunity_id") @db.Uuid
  scheduledAt       DateTime? @map("scheduled_at") @db.Timestamptz(3)
  visitedAt         DateTime? @map("visited_at") @db.Timestamptz(3)
  visitorEmployeeId String?   @map("visitor_employee_id") @db.Uuid
  trade             String?
  /// [{ label, value, unit }]
  measurements      Json      @default("[]")
  /// [{ label, done }]
  checklist         Json      @default("[]")
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy         String?   @map("created_by") @db.Uuid

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([tenantId, opportunityId])
  @@map("site_visits")
}

enum AttachmentKind {
  photo
  document
  voice_note
}

/// Pièce jointe générique (photo, document, note vocale) rattachée à un objet.
model Attachment {
  id               String         @id @default(uuid(7)) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  ownerType        String         @map("owner_type")
  ownerId          String         @map("owner_id") @db.Uuid
  kind             AttachmentKind
  storageKey       String         @map("storage_key")
  fileName         String         @map("file_name")
  contentType      String         @map("content_type")
  sizeBytes        Int            @map("size_bytes")
  sha256           String?
  takenAt          DateTime?      @map("taken_at") @db.Timestamptz(3)
  latitude         Decimal?       @db.Decimal(9, 6)
  longitude        Decimal?       @db.Decimal(9, 6)
  caption          String?
  transcript       String?
  transcriptStatus String?        @map("transcript_status")
  visibleToClient  Boolean        @default(false) @map("visible_to_client")
  /// Tâche du chantier concernée (galerie par tâche).
  taskId           String?        @map("task_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy        String?        @map("created_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, ownerType, ownerId])
  @@map("attachments")
}

// ---------------------------------------------------------------------------
// Fournisseurs et bibliothèque (03 §3, §8)
// ---------------------------------------------------------------------------

model Supplier {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  name             String
  enterpriseNumber String?   @map("enterprise_number")
  vatNumber        String?   @map("vat_number")
  peppolId         String?   @map("peppol_id")
  email            String?
  orderEmail       String?   @map("order_email")
  phone            String?
  street           String?
  postalCode       String?   @map("postal_code")
  city             String?
  country          String    @default("BE")
  iban             String?
  paymentTermsDays Int       @default(30) @map("payment_terms_days")
  isSubcontractor  Boolean   @default(false) @map("is_subcontractor")
  notes            String?
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy        String?   @map("created_by") @db.Uuid

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  Item[]
  prices SupplierPrice[]

  @@index([tenantId, name])
  @@map("suppliers")
}

enum ItemKind {
  material
  labour
  subcontracting
  equipment
  lump_sum
  assembly
}

model Item {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  code            String
  kind            ItemKind
  name            String
  description     String?
  unit            String
  /// Prix d'achat / de revient unitaire HTVA (centimes). Pour un ouvrage : calculé.
  purchasePrice   BigInt    @default(0) @map("purchase_price")
  /// Prix de vente forcé (centimes) ; sinon calculé par coefficient.
  salePrice       BigInt?   @map("sale_price")
  /// Coefficient propre à l'article (sinon celui du tenant).
  saleCoefficient Decimal?  @map("sale_coefficient") @db.Decimal(6, 4)
  vatRate         String    @default("auto") @map("vat_rate")
  /// Temps de pose par unité, en heures (main-d'œuvre).
  laborHours      Decimal   @default(0) @map("labor_hours") @db.Decimal(10, 4)
  trade           String?
  category        String?
  supplierId      String?   @map("supplier_id") @db.Uuid
  supplierCode    String?   @map("supplier_code")
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy       String?   @map("created_by") @db.Uuid

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier   Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  components AssemblyComponent[] @relation("AssemblyParent")
  usedIn     AssemblyComponent[] @relation("AssemblyChild")
  history    PriceHistory[]

  @@unique([tenantId, code])
  @@index([tenantId, kind])
  @@map("items")
}

model AssemblyComponent {
  id         String  @id @default(uuid(7)) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  assemblyId String  @map("assembly_id") @db.Uuid
  itemId     String  @map("item_id") @db.Uuid
  quantity   Decimal @db.Decimal(14, 4)
  position   Int     @default(0)

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assembly Item   @relation("AssemblyParent", fields: [assemblyId], references: [id], onDelete: Cascade)
  item     Item   @relation("AssemblyChild", fields: [itemId], references: [id], onDelete: Restrict)

  @@index([tenantId, assemblyId])
  @@map("assembly_components")
}

model PriceHistory {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  itemId        String   @map("item_id") @db.Uuid
  purchasePrice BigInt   @map("purchase_price")
  salePrice     BigInt?  @map("sale_price")
  source        String
  changedAt     DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)
  changedBy     String?  @map("changed_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([tenantId, itemId, changedAt])
  @@map("price_history")
}

model SupplierPrice {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  supplierId   String   @map("supplier_id") @db.Uuid
  supplierCode String   @map("supplier_code")
  label        String
  unit         String?
  price        BigInt
  itemId       String?  @map("item_id") @db.Uuid
  validFrom    DateTime @default(now()) @map("valid_from") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([tenantId, supplierId, supplierCode])
  @@map("supplier_prices")
}

// ---------------------------------------------------------------------------
// M3 — Devis, signature, portail ; chantier, postes, tâches et acompte créés à la signature
// ---------------------------------------------------------------------------

enum QuoteStatus {
  draft
  sent
  viewed
  signed
  refused
  expired
  superseded
}

/// En-tête stable d'un devis ; le contenu vit dans des versions figées après envoi.
model Quote {
  id               String      @id @default(uuid(7)) @db.Uuid
  tenantId         String      @map("tenant_id") @db.Uuid
  /// Numéro (D2026-001). Nul pour un modèle de devis.
  number           String?
  title            String
  customerId       String?     @map("customer_id") @db.Uuid
  siteId           String?     @map("site_id") @db.Uuid
  opportunityId    String?     @map("opportunity_id") @db.Uuid
  status           QuoteStatus @default(draft)
  currentVersionId String?     @map("current_version_id") @db.Uuid
  validityDays     Int         @default(30) @map("validity_days")
  validUntil       DateTime?   @map("valid_until") @db.Timestamptz(3)
  sentAt           DateTime?   @map("sent_at") @db.Timestamptz(3)
  viewedAt         DateTime?   @map("viewed_at") @db.Timestamptz(3)
  signedAt         DateTime?   @map("signed_at") @db.Timestamptz(3)
  refusedAt        DateTime?   @map("refused_at") @db.Timestamptz(3)
  refusalReason    String?     @map("refusal_reason")
  reminderSentAt   DateTime?   @map("reminder_sent_at") @db.Timestamptz(3)
  /// Modèle réutilisable (pas de client, pas de numéro).
  isTemplate       Boolean     @default(false) @map("is_template")
  ownerUserId      String?     @map("owner_user_id") @db.Uuid
  archivedAt       DateTime?   @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy        String?     @map("created_by") @db.Uuid

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        Customer?        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  site            Site?            @relation(fields: [siteId], references: [id], onDelete: SetNull)
  opportunity     Opportunity?     @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  versions        QuoteVersion[]
  vatCertificates VatCertificate[]
  portalTokens    PortalToken[]
  project         Project?

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([opportunityId])
  @@map("quotes")
}

model QuoteVersion {
  id                    String      @id @default(uuid(7)) @db.Uuid
  tenantId              String      @map("tenant_id") @db.Uuid
  quoteId               String      @map("quote_id") @db.Uuid
  version               Int
  status                QuoteStatus @default(draft)
  intro                 String?
  notes                 String?
  globalDiscountPercent Decimal     @default(0) @map("global_discount_percent") @db.Decimal(6, 4)
  /// Acompte : `percent` (valeur en %) ou `amount` (valeur en centimes TVAC).
  depositKind           String?     @map("deposit_kind")
  depositValue          Decimal?    @map("deposit_value") @db.Decimal(16, 4)
  /// Échéancier contractuel : [{ label, percent }].
  paymentSchedule       Json        @default("[]") @map("payment_schedule")
  /// Contexte TVA figé (client, logement, âge) ayant servi à proposer les régimes.
  vatContext            Json        @default("{}") @map("vat_context")
  /// Totaux de la version (choix d'options inclus), pour les listes ; recalculés à chaque enregistrement.
  totalNet              BigInt      @default(0) @map("total_net")
  totalVat              BigInt      @default(0) @map("total_vat")
  totalGross            BigInt      @default(0) @map("total_gross")
  totalCost             BigInt      @default(0) @map("total_cost")
  depositAmount         BigInt      @default(0) @map("deposit_amount")
  /// PDF figé à l'envoi et à la signature (empreinte SHA-256 = preuve).
  pdfKey                String?     @map("pdf_key")
  pdfSha256             String?     @map("pdf_sha256")
  /// Compteur d'enregistrements (concurrence optimiste de l'éditeur).
  revision              Int         @default(0)
  sentAt                DateTime?   @map("sent_at") @db.Timestamptz(3)
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy             String?     @map("created_by") @db.Uuid

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote    Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  sections QuoteSection[]
  lines    QuoteLine[]

  @@unique([quoteId, version])
  @@map("quote_versions")
}

/// Poste du devis (devient un poste budgétaire du chantier).
model QuoteSection {
  id          String  @id @default(uuid(7)) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  versionId   String  @map("version_id") @db.Uuid
  /// Clé stable d'une version à l'autre (comparatif, postes budgétaires).
  key         String  @db.Uuid
  position    Int
  title       String
  description String?
  optional    Boolean @default(false)
  selected    Boolean @default(false)

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  version QuoteVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  lines   QuoteLine[]

  @@unique([versionId, key])
  @@map("quote_sections")
}

model QuoteLine {
  id               String  @id @default(uuid(7)) @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  versionId        String  @map("version_id") @db.Uuid
  sectionId        String  @map("section_id") @db.Uuid
  key              String  @db.Uuid
  position         Int
  /// `item` (ligne chiffrée) ou `text` (texte libre).
  kind             String  @default("item")
  itemId           String? @map("item_id") @db.Uuid
  code             String?
  description      String
  unit             String  @default("u")
  quantity         Decimal @default(1) @db.Decimal(14, 4)
  unitPrice        BigInt  @default(0) @map("unit_price")
  unitCost         BigInt  @default(0) @map("unit_cost")
  laborHours       Decimal @default(0) @map("labor_hours") @db.Decimal(10, 4)
  vatRegime        String  @map("vat_regime")
  /// Régime proposé automatiquement ; un écart exige une justification (tracée).
  vatSuggested     String  @map("vat_suggested")
  vatJustification String? @map("vat_justification")
  discountPercent  Decimal @default(0) @map("discount_percent") @db.Decimal(6, 4)

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  version QuoteVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  section QuoteSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([versionId, key])
  @@index([sectionId])
  @@map("quote_lines")
}

/// Signature électronique simple (05 §10) : identité déclarée, horodatage, IP, user-agent, empreinte.
model Signature {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  /// `quote_version`, `vat_certificate`, plus tard `change_order`, `work_order`, `reception`.
  subjectType    String   @map("subject_type")
  subjectId      String   @map("subject_id") @db.Uuid
  signerName     String   @map("signer_name")
  signerEmail    String?  @map("signer_email")
  /// Tracé de la signature (chemin SVG), vide si signature saisie au clavier.
  signatureImage String?  @map("signature_image")
  acceptedTerms  Boolean  @map("accepted_terms")
  ip             String?
  userAgent      String?  @map("user_agent")
  /// SHA-256 du PDF signé.
  documentSha256 String   @map("document_sha256")
  documentKey    String?  @map("document_key")
  portalTokenId  String?  @map("portal_token_id") @db.Uuid
  signedAt       DateTime @default(now()) @map("signed_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([subjectType, subjectId])
  @@map("signatures")
}

/// Attestation du client pour la TVA à 6 % en rénovation (05 §3).
model VatCertificate {
  id                 String    @id @default(uuid(7)) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  quoteId            String    @map("quote_id") @db.Uuid
  customerId         String    @map("customer_id") @db.Uuid
  siteId             String?   @map("site_id") @db.Uuid
  projectId          String?   @map("project_id") @db.Uuid
  status             String    @default("pending")
  firstOccupancyYear Int?      @map("first_occupancy_year")
  /// Déclarations cochées par le client (texte versionné [à valider]).
  declarations       Json      @default("{}")
  signatureId        String?   @map("signature_id") @db.Uuid
  signedAt           DateTime? @map("signed_at") @db.Timestamptz(3)
  pdfKey             String?   @map("pdf_key")
  pdfSha256          String?   @map("pdf_sha256")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote  Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId])
  @@map("vat_certificates")
}

/// Lien de portail signé (client ou sous-traitant) : seule l'empreinte du jeton est stockée.
model PortalToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  /// `quote` (un devis) ou `project` (un chantier).
  kind       String
  quoteId    String?   @map("quote_id") @db.Uuid
  projectId  String?   @map("project_id") @db.Uuid
  customerId String?   @map("customer_id") @db.Uuid
  email      String?
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy  String?   @map("created_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote  Quote? @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([tenantId, quoteId])
  @@index([tenantId, projectId])
  @@map("portal_tokens")
}

enum ProjectStatus {
  preparation
  in_progress
  suspended
  provisional_acceptance
  final_acceptance
  closed
}

/// Le chantier, objet pivot (03 §5). Créé à la signature du devis.
model Project {
  id              String        @id @default(uuid(7)) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  number          String
  name            String
  customerId      String        @map("customer_id") @db.Uuid
  siteId          String?       @map("site_id") @db.Uuid
  quoteId         String?       @unique @map("quote_id") @db.Uuid
  opportunityId   String?       @map("opportunity_id") @db.Uuid
  status          ProjectStatus @default(preparation)
  /// Montant du contrat HTVA (devis signé + avenants signés).
  contractAmount  BigInt        @default(0) @map("contract_amount")
  managerUserId   String?       @map("manager_user_id") @db.Uuid
  teamId          String?       @map("team_id") @db.Uuid
  description     String?
  startDate       DateTime?     @map("start_date") @db.Date
  endDate         DateTime?     @map("end_date") @db.Date
  /// Raison de la suspension (statut `suspended`).
  suspendedReason String?       @map("suspended_reason")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy       String?       @map("created_by") @db.Uuid

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote        Quote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  budgetLines  BudgetLine[]
  tasks        Task[]
  invoices     Invoice[]
  changeOrders ChangeOrder[]
  costs        ProjectCost[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("projects")
}

/// Poste budgétaire : un par poste du devis signé, puis alimenté par les avenants.
model BudgetLine {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  quoteSectionKey String?  @map("quote_section_key") @db.Uuid
  position        Int
  label           String
  /// Coût budgété (prix de revient du devis).
  budgetedCost    BigInt   @default(0) @map("budgeted_cost")
  /// Montant vendu HTVA.
  saleAmount      BigInt   @default(0) @map("sale_amount")
  laborHours      Decimal  @default(0) @map("labor_hours") @db.Decimal(12, 4)
  /// Poste créé par un avenant (nouveau poste).
  changeOrderId   String?  @map("change_order_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]
  costs   ProjectCost[]

  @@unique([projectId, quoteSectionKey])
  @@map("budget_lines")
}

model Task {
  id                 String    @id @default(uuid(7)) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  projectId          String    @map("project_id") @db.Uuid
  budgetLineId       String?   @map("budget_line_id") @db.Uuid
  quoteLineKey       String?   @map("quote_line_key") @db.Uuid
  position           Int
  title              String
  /// `todo`, `in_progress`, `done`.
  status             String    @default("todo")
  quantity           Decimal?  @db.Decimal(14, 4)
  unit               String?
  plannedHours       Decimal   @default(0) @map("planned_hours") @db.Decimal(12, 4)
  /// Montant de vente HTVA de la tâche : pondère l'avancement du poste.
  amount             BigInt    @default(0)
  /// Avancement de 0 à 1 (1 quand la tâche est faite).
  progress           Decimal   @default(0) @db.Decimal(5, 4)
  description        String?
  /// Checklist : [{ id, label, done }].
  checklist          Json      @default("[]")
  assigneeEmployeeId String?   @map("assignee_employee_id") @db.Uuid
  dueDate            DateTime? @map("due_date") @db.Date
  changeOrderLineId  String?   @unique @map("change_order_line_id") @db.Uuid
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(3)
  completedBy        String?   @map("completed_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  budgetLine BudgetLine? @relation(fields: [budgetLineId], references: [id], onDelete: SetNull)

  @@unique([projectId, quoteLineKey])
  @@index([projectId, position])
  @@map("tasks")
}

enum InvoiceType {
  deposit
  progress
  work_order
  final
  retention_release
  free
}

enum InvoiceStatus {
  draft
  issued
  sent
  delivered
  partially_paid
  paid
  cancelled
}

/// Facture client. Numérotée et immuable à l'émission (M8) ; ici le brouillon d'acompte.
model Invoice {
  id         String        @id @default(uuid(7)) @db.Uuid
  tenantId   String        @map("tenant_id") @db.Uuid
  projectId  String?       @map("project_id") @db.Uuid
  customerId String        @map("customer_id") @db.Uuid
  quoteId    String?       @map("quote_id") @db.Uuid
  type       InvoiceType
  status     InvoiceStatus @default(draft)
  /// Attribué à l'émission (séquence sans trou).
  number     String?
  title      String
  totalNet   BigInt        @default(0) @map("total_net")
  totalVat   BigInt        @default(0) @map("total_vat")
  totalGross BigInt        @default(0) @map("total_gross")
  issuedAt   DateTime?     @map("issued_at") @db.Timestamptz(3)
  dueDate    DateTime?     @map("due_date") @db.Date
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy  String?       @map("created_by") @db.Uuid

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  lines   InvoiceLine[]

  @@unique([tenantId, number])
  @@unique([quoteId, type])
  @@index([tenantId, status])
  @@map("invoices")
}

model InvoiceLine {
  id           String  @id @default(uuid(7)) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  invoiceId    String  @map("invoice_id") @db.Uuid
  position     Int
  description  String
  unit         String  @default("u")
  quantity     Decimal @default(1) @db.Decimal(14, 4)
  unitPrice    BigInt  @map("unit_price")
  vatRegime    String  @map("vat_regime")
  budgetLineId String? @map("budget_line_id") @db.Uuid

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_lines")
}

/// Fil chronologique lisible (projection des événements), par client, affaire, devis ou chantier.
model TimelineEntry {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  eventId         String?  @unique @map("event_id") @db.Uuid
  type            String
  title           String
  body            String?
  customerId      String?  @map("customer_id") @db.Uuid
  opportunityId   String?  @map("opportunity_id") @db.Uuid
  quoteId         String?  @map("quote_id") @db.Uuid
  projectId       String?  @map("project_id") @db.Uuid
  changeOrderId   String?  @map("change_order_id") @db.Uuid
  /// Montant affiché à droite de l'entrée (positif ou négatif), en centimes.
  amount          BigInt?
  /// Données d'affichage (ids des photos, poste concerné…).
  data            Json?
  /// Visible sur le portail client.
  visibleToClient Boolean  @default(false) @map("visible_to_client")
  actorLabel      String?  @map("actor_label")
  occurredAt      DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId, occurredAt])
  @@index([tenantId, quoteId])
  @@index([tenantId, customerId])
  @@map("timeline_entries")
}

enum ChangeOrderStatus {
  draft
  sent
  signed
  refused
}

/// Avenant (03 §5, 02 P5) : porte ses propres lignes ; une fois signé, il met à jour le budget
/// et le contrat. Numéro légal attribué à l'envoi (séquence sans trou), ordinal par chantier.
model ChangeOrder {
  id            String            @id @default(uuid(7)) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  projectId     String            @map("project_id") @db.Uuid
  /// « Avenant n°2 » : rang dans le chantier.
  ordinal       Int
  number        String?
  title         String
  description   String?
  status        ChangeOrderStatus @default(draft)
  /// Prolongation du chantier en jours ouvrés (0 = aucun impact sur la date de fin).
  delayDays     Int               @default(0) @map("delay_days")
  /// Origine : signalement terrain (M5) ou saisie manuelle.
  issueId       String?           @map("issue_id") @db.Uuid
  totalNet      BigInt            @default(0) @map("total_net")
  totalVat      BigInt            @default(0) @map("total_vat")
  totalGross    BigInt            @default(0) @map("total_gross")
  totalCost     BigInt            @default(0) @map("total_cost")
  laborHours    Decimal           @default(0) @map("labor_hours") @db.Decimal(12, 4)
  /// Révision optimiste de l'éditeur.
  revision      Int               @default(0)
  sentAt        DateTime?         @map("sent_at") @db.Timestamptz(3)
  sentTo        String?           @map("sent_to")
  signedAt      DateTime?         @map("signed_at") @db.Timestamptz(3)
  refusedAt     DateTime?         @map("refused_at") @db.Timestamptz(3)
  refusalReason String?           @map("refusal_reason")
  signatureId   String?           @map("signature_id") @db.Uuid
  pdfKey        String?           @map("pdf_key")
  pdfSha256     String?           @map("pdf_sha256")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy     String?           @map("created_by") @db.Uuid

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lines   ChangeOrderLine[]

  @@unique([projectId, ordinal])
  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("change_orders")
}

model ChangeOrderLine {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  changeOrderId   String   @map("change_order_id") @db.Uuid
  position        Int
  /// Poste existant du chantier, ou null pour un nouveau poste (`newPostLabel`).
  budgetLineId    String?  @map("budget_line_id") @db.Uuid
  newPostLabel    String?  @map("new_post_label")
  itemId          String?  @map("item_id") @db.Uuid
  code            String?
  description     String
  unit            String   @default("u")
  quantity        Decimal  @default(1) @db.Decimal(14, 4)
  unitPrice       BigInt   @map("unit_price")
  unitCost        BigInt   @default(0) @map("unit_cost")
  laborHours      Decimal  @default(0) @map("labor_hours") @db.Decimal(12, 4)
  discountPercent Decimal? @map("discount_percent") @db.Decimal(7, 4)
  vatRegime       String   @map("vat_regime")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  changeOrder ChangeOrder @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)

  @@index([changeOrderId, position])
  @@map("change_order_lines")
}

enum CostCategory {
  supplier_invoice
  purchase_order
  labour
  stock
  equipment
  subcontract
  other
}

/// Grand livre des coûts engagés du chantier (04 « Engagé ») : chaque source (facture
/// fournisseur, BC ouvert, heures validées, sortie de stock…) y écrit sa ligne via un
/// consommateur idempotent ; (catégorie, source) est unique, la ligne est mise à jour en place.
model ProjectCost {
  id           String       @id @default(uuid(7)) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  projectId    String       @map("project_id") @db.Uuid
  budgetLineId String?      @map("budget_line_id") @db.Uuid
  category     CostCategory
  sourceType   String       @map("source_type")
  sourceId     String       @map("source_id")
  label        String
  amount       BigInt
  occurredAt   DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  budgetLine BudgetLine? @relation(fields: [budgetLineId], references: [id], onDelete: SetNull)

  @@unique([tenantId, category, sourceType, sourceId])
  @@index([tenantId, projectId])
  @@map("project_costs")
}

/// Commentaire sur un objet (chantier, avenant, devis, facture) : fil interne, ou partagé avec
/// le client quand `visibleToClient` (questions posées depuis le portail et réponses).
model Comment {
  id                String    @id @default(uuid(7)) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  /// `project`, `change_order`, `quote`, `invoice`, `task`.
  subjectType       String    @map("subject_type")
  subjectId         String    @map("subject_id") @db.Uuid
  projectId         String?   @map("project_id") @db.Uuid
  body              String
  /// Utilisateurs mentionnés (@).
  mentions          String[]  @default([]) @db.Uuid
  authorUserId      String?   @map("author_user_id") @db.Uuid
  authorPortalToken String?   @map("author_portal_token_id") @db.Uuid
  authorLabel       String    @map("author_label")
  visibleToClient   Boolean   @default(false) @map("visible_to_client")
  /// Question du client traitée (réponse donnée ou marquée résolue).
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, subjectType, subjectId, createdAt])
  @@index([tenantId, projectId, createdAt])
  @@map("comments")
}
